{
  "name": "uniserve-backend",
  "version": "1.0.0",
  "description": "UniServe marketplace & social platform backend (TypeScript, Express, MongoDB)",
  "main": "dist/server.js",
  "scripts": {
    "start": "node scripts/runServerWithPortCleanup.js start",
    "dev": "node scripts/runServerWithPortCleanup.js dev",
    "start:clean": "node scripts/runServerWithPortCleanup.js start --force-clean",
    "port:5001:kill": "node scripts/killPort.js 5001",
    "backfill:cover-image-url": "ts-node scripts/backfillCoverImageUrl.ts",
    "fix:duplicate-slugs": "ts-node scripts/fixDuplicateSlugs.ts",
    "migrate:news-posts": "ts-node scripts/migrateNewsPostsToPosts.ts",
    "cleanup:duplicate-listings": "ts-node scripts/removeDuplicateListings.ts",
    "backfill:cover-images": "ts-node scripts/backfillCoverImages.ts",
    "fix:listings-images": "ts-node scripts/fixListingImages.ts",
    "fix:listings-topic-images": "ts-node scripts/fixListingTopicImages.ts",
    "fill:listings-images": "ts-node scripts/fillMissingListingImages.ts",
    "fix:agent-avatars": "ts-node scripts/fixAgentAvatarUrls.ts",
    "check:agents-integrity": "ts-node scripts/checkAgentsIntegrity.ts",
    "fix:agents-integrity": "ts-node scripts/checkAgentsIntegrity.ts --fix",
    "seed:home-listings": "ts-node scripts/seedHomeListings.ts",
    "test:listing-selector": "node --test -r ts-node/register tests/listingSelector.test.ts",
    "test:backend": "node --test -r ts-node/register tests/*.test.ts"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
